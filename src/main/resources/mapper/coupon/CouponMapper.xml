<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mallu.coupon.mapper.CouponMapper">

    <resultMap id="BaseResultMap" type="com.example.mallu.coupon.entity.Coupon">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="threshold" property="threshold"/>
        <result column="discount_value" property="discountValue"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="total_count" property="totalCount"/>
        <result column="remaining_count" property="remainingCount"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, type, threshold, discount_value, start_time, end_time, total_count, remaining_count, status, created_at, updated_at, create_by, update_by
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM coupon
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectAvailable" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM coupon
        WHERE status = 1
          AND remaining_count &gt; 0
          AND start_time &lt;= NOW()
          AND end_time &gt;= NOW()
        ORDER BY id DESC
    </select>

    <update id="decreaseRemainingCount">
        UPDATE coupon
        SET remaining_count = remaining_count - #{quantity}
        WHERE id = #{id} AND remaining_count &gt;= #{quantity}
    </update>

</mapper>