<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mallu.seckill.mapper.SeckillActivityMapper">

    <resultMap id="BaseResultMap" type="com.example.mallu.seckill.entity.SeckillActivity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, start_time, end_time, status, created_at, updated_at, create_by, update_by
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM seckill_activity
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM seckill_activity
        WHERE status = 1
          AND start_time &lt;= NOW()
          AND end_time &gt;= NOW()
        ORDER BY id DESC
    </select>
</mapper>
